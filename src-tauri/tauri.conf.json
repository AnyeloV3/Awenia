{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Awenia",
  "version": "4.0.0",
  "identifier": "cr.awenia.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Awenia — Administración de Crochet",
        "width": 1180,
        "height": 780,
        "minWidth": 320,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Administración local para crochet",
    "longDescription": "Awenia organiza productos, materiales, ventas, caja, inventario, pedidos, proveedores y estadísticas de un emprendimiento de crochet de forma local.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "installer/awenia-installer.ico",
        "uninstallerIcon": "installer/awenia-installer.ico",
        "headerImage": "installer/awenia-header.bmp",
        "uninstallerHeaderImage": "installer/awenia-header.bmp",
        "sidebarImage": "installer/awenia-sidebar.bmp",
        "startMenuFolder": "Awenia"
      }
    }
  }
}